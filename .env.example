# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=your-openai-api-key

# Optional backend settings (defaults shown). Relative paths are resolved from the backend folder.
# OPENAI_MODEL=gpt-4o-mini
# DATABASE_PATH=data/store.db
# CHECKPOINT_PATH=data/checkpoints.db
# STORE_TODAY=2026-09-15
# MAX_TOOL_STEPS=6

# Frontend (optional, defaults to http://localhost:8000). Put it in frontend/.env.local.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Docker Compose overrides (optional). Use these if port 3000 is taken on your machine.
# FRONTEND_PORT=3001
# CORS_ORIGINS=http://localhost:3001
